[Unit]
Description=Order service
After=network.target

[Service]
User={{ order_service_user }}
Environment=NOTIFICATION_URL={{ order_service_notification_url }}
ExecStart=/usr/bin/java -jar {{ order_service_root }}/current/order-service.jar
Restart=on-failure
RestartSec=5
SuccessExitStatus=143

[Install]
WantedBy=multi-user.target
