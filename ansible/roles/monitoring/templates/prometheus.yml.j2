global:
  scrape_interval: 15s
  evaluation_interval: 15s

rule_files:
  - /etc/prometheus/rules/*.yml

scrape_configs:
  - job_name: order-service
    metrics_path: /actuator/prometheus
    static_configs:
      - targets:
{% for h in groups['role_app'] | default([]) %}
          - "{{ hostvars[h].ansible_host }}:{{ app_port_order }}"
{% endfor %}

  - job_name: notification-service
    metrics_path: /metrics
    static_configs:
      - targets:
{% for h in groups['role_app'] | default([]) %}
          - "{{ hostvars[h].ansible_host }}:{{ app_port_notification }}"
{% endfor %}

  - job_name: node
    static_configs:
      - targets:
{% for h in groups['role_app'] | default([]) %}
          - "{{ hostvars[h].ansible_host }}:{{ node_exporter_port }}"
{% endfor %}
